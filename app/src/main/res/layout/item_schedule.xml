<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Email sinh viên -->
    <TextView
        android:id="@+id/tvStudentEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email sinh viên: ..."
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <!-- Tên công ty thực tập -->
    <TextView
        android:id="@+id/tvInternshipCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Công ty: ..."
        android:textSize="14sp"
        android:textColor="#333333" />

    <!-- Thời gian phỏng vấn -->
    <TextView
        android:id="@+id/tvInterviewTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thời gian phỏng vấn: ..."
        android:textSize="14sp"
        android:textColor="#333333" />

    <!-- Trạng thái phỏng vấn -->
    <TextView
        android:id="@+id/tvInterviewStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái: ..."
        android:textSize="14sp"
        android:textColor="#333333" />

    <!-- Ghi chú phỏng vấn -->
    <TextView
        android:id="@+id/tvInterviewNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ghi chú: ..."
        android:textSize="14sp"
        android:textColor="#333333" />

</LinearLayout>