<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp" android:elevation="2dp"> <TextView
    android:id="@+id/tvAppTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Tên công việc"
    android:textStyle="bold"
    android:textSize="16sp"
    android:textColor="@android:color/black"/>

    <TextView
        android:id="@+id/tvAppCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên công ty"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <TextView
        android:id="@+id/tvAppStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái ứng tuyển"
        android:textSize="14sp"
        android:textColor="@android:color/holo_blue_dark"/>

    <TextView
        android:id="@+id/tvAppAppliedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ngày ứng tuyển"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <Button
        android:id="@+id/btnViewResume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xem CV"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/design_default_color_primary"
        android:textColor="@android:color/white"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/tvInterviewTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thời gian phỏng vấn: "
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvInterviewStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái phỏng vấn: "
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvInterviewNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ghi chú phỏng vấn: "
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Approved"
        android:layout_marginTop="8dp"/>
    <Button
        android:id="@+id/btnReject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reject"
        android:layout_marginTop="8dp"
        android:backgroundTint="@android:color/holo_red_light"
        android:textColor="@android:color/white"
        />

    <Button
        android:id="@+id/btnWithdraw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Rút đơn"
        android:enabled="true" />

    <!-- Thông báo sau khi xác nhận hoặc từ chối -->
    <TextView
        android:id="@+id/tvActionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/purple_700"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>


</LinearLayout>